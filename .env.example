APP_NAME="Osole Tickets"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Producción: tu dominio real con https (el link de "recuperar contraseña" usa esto).
APP_URL=http://localhost:8001

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = los mails/notificaciones se envían en el mismo request (sin worker). Ideal para cPanel.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Email ─────────────────────────────────────────────────────────────
# Desarrollo: "log" escribe los correos en storage/logs/laravel.log (NO envía).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="soporte@example.com"
MAIL_FROM_NAME="Osole Soporte"
# Correos internos que reciben copia profesional cada vez que se crea un ticket.
# Separar por coma, punto y coma o espacio.
TICKET_CREATED_COPY_EMAILS="aleradatsi@gmail.com,osole2017@gmail.com"

# PRODUCCIÓN (cPanel): poné MAIL_MAILER=smtp y completá con la cuenta de correo
# creada en cPanel → "Cuentas de correo". Puerto 465 = SSL (MAIL_SCHEME=smtps) o
# 587 = TLS (MAIL_SCHEME=smtp). Con esto funcionan el "Avisar al cliente" y el
# "Olvidé mi contraseña"; NO hace falta worker de cola (se envían en el momento).
# MAIL_MAILER=smtp
# MAIL_HOST=cp003.servidoresph.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=soporte@osole.com.ar
# MAIL_PASSWORD=

# Primer usuario administrador. Cambiar SIEMPRE antes de correr seeders en producción.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

# WhatsApp click-to-chat: código de país por defecto para normalizar números (54 = Argentina).
WHATSAPP_COUNTRY=54

# Avisos automáticos de tickets por Telegram. El token del bot y los chat IDs se
# cargan desde el panel (Configuración → Avisos Telegram), no acá. Esta variable
# es opcional (tiene valor por defecto):
# TELEGRAM_TIMEOUT=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
